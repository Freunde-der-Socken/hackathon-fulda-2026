# Copy to .env.prod (git-ignored) and fill in the secrets. Compose refuses to start without them.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional
POSTGRES_USER=app
POSTGRES_DB=app
# ":80" is plain HTTP. A domain name enables automatic HTTPS (also publish 443)
SITE_ADDRESS=:80
# Only when SITE_ADDRESS contains an IP (phones need HTTPS for the microphone): that single IP.
# TLS_DEFAULT_SNI=
# Origin(s) the browser loads the app from. Only matters if it differs from the web host.
CORS_ORIGIN=http://localhost
# Base URL of the watering can (the API POSTs to <url>/water). Unset sends nothing.
# WATERING_CAN_URL=
WEB_PORT=80
WEB_HTTPS_PORT=443
# Prebuilt images from GHCR (see README). Pin a commit SHA instead of latest
# IMAGE_TAG=latest
