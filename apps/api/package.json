{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=../../.env --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=../../.env --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@repo/contracts": "workspace:*",
    "@scalar/fastify-api-reference": "^1.75.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/oxc-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "5.0.5"
  }
}
