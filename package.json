{
  "name": "hackathon-fulda-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @repo/api db:migrate",
    "db:seed": "pnpm --filter @repo/api db:seed"
  },
  "devDependencies": {
    "@repo/oxc-config": "workspace:*",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "turbo": "^2.11.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
